# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.
# Nothing here is ever written to the database or the repository.

# --- required in production ---------------------------------------------------
# Long random string used to sign session cookies (e.g. `openssl rand -base64 48`).
AUTH_SECRET=
# Password for the seeded demo accounts (sara.khan@ssi.example, omar.siddiqui@ssi.example, admin@ssi.example).
DEMO_PASSWORD=

# --- AI (recommended) -----------------------------------------------------------
# Without a key every agent runs on its deterministic fallback ("heuristic mode").
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: claude-opus-5-5 for reasoning, claude-haiku-5-5 for summarising.
# SMART_MODEL=claude-opus-5-5
# CHEAP_MODEL=claude-haiku-5-5
# Optional local model (Ollama, LM Studio, vLLM) for projects whose code must not leave your network.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen2.5-coder:7b
# LOCAL_LLM_API_KEY=
# Route the whole summarising tier to the local model: CHEAP_PROVIDER=local
# Force heuristics even when a key is present: PROJECT_AID_LLM=off

# --- storage (recommended on Vercel) ----------------------------------------------
# Upstash Redis / Vercel KV. Without it data lives in memory and resets when an instance restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Skip seeding the demo portfolio: PROJECT_AID_SEED=off

# --- deployment ---------------------------------------------------------------
# Public URL used in reply links sent to team members. Detected automatically on Vercel.
# APP_BASE_URL=https://your-app.vercel.app
# Protects /api/cron/sync. Vercel Cron sends it automatically once set.
CRON_SECRET=

# --- integrations (all optional; each source can name its own variable) --------------
# GITHUB_TOKEN=            # read access to the repositories you connect
# GITHUB_WEBHOOK_SECRET=   # secret of the webhook pointing at /api/webhooks/github
# AZURE_DEVOPS_PAT=        # Azure DevOps / TFS personal access token (Code: read, Work items: read)
# JIRA_API_TOKEN=
# MS_GRAPH_TOKEN=          # Microsoft Graph token for Teams channel messages and Outlook
# SLACK_BOT_TOKEN=
# VERCEL_TOKEN=            # deployment status of Vercel projects
# TEAMS_WEBHOOK_URL=       # incoming webhook used to send questions to the team in Teams
# TEAMS_OUTGOING_WEBHOOK_SECRET=  # lets directors @mention the assistant in Teams (/api/integrations/teams)
# SLACK_WEBHOOK_URL=
# SLACK_SIGNING_SECRET=    # slash command at /api/integrations/slack
# RESEND_API_KEY=          # email delivery of questions to the team
# EMAIL_FROM="Project Aid <aid@yourdomain.com>"
